# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=treoo
POSTGRES_USER=treoo
POSTGRES_PASSWORD=change-me
APP_PORT=3000

# manual = AI off, mock = simulated (labelled) output, ollama = real inference
AI_MODE=mock
OLLAMA_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct

# auto = Secure cookie when served over HTTPS (e.g. behind a Cloudflare tunnel)
COOKIE_SECURE=auto
