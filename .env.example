# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=treoo
POSTGRES_USER=treoo
POSTGRES_PASSWORD=change-me
APP_PORT=3000

# manual = AI off, mock = simulated (labelled) output, ollama = local inference, openrouter = OpenRouter API
AI_MODE=mock

# OpenRouter (AI_MODE=openrouter). The key stays on the server; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Optional: public URL of the app, shown to OpenRouter for attribution
APP_URL=

OLLAMA_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct

# auto = Secure cookie when served over HTTPS (e.g. behind a Cloudflare tunnel)
COOKIE_SECURE=auto
